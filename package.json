{
  "name": "waifutxt-",
  "private": true,
  "version": "0.58.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Client Matrix — interface Discord, thème cyberpunk/anime. E2EE, threads, voix, DMs, waifus.",
  "author": {
    "name": "Otherside410",
    "email": "noreply@waifuchat.dev"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "version:bump": "npm version patch --no-git-tag-version",
    "version:auto": "node ./scripts/bump-version-from-commit.mjs",
    "prepare": "husky",
    "app": "npm run build && electron .",
    "app:linux": "npm run build && electron-builder --linux",
    "app:win": "npm run build && electron-builder --win",
    "app:all": "npm run build && electron-builder --linux --win"
  },
  "build": {
    "appId": "dev.otherside410.waifutxt",
    "productName": "WaifuTxT_",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Otherside410 <noreply@waifuchat.dev>",
      "category": "Network",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.0.0",
    "@types/qrcode": "^1.5.6",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.18.0",
    "emojibase-data": "^17.0.0",
    "matrix-js-sdk": "^41.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0"
  }
}
